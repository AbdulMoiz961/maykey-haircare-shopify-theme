{% comment %}
  Maykey Hair Care — SEO Meta Tags & JSON-LD Structured Data
{% endcomment %}
{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_url = canonical_url | default: request.origin -%}
{%- assign og_type = 'website' -%}
{%- assign og_description = page_description | default: shop.description | default: shop.name -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_type = 'product' -%}
  {%- if product.featured_image -%}
    {%- assign og_image_url = product.featured_image | image_url: width: 1200 -%}
  {%- endif -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign og_type = 'article' -%}
  {%- if article.image -%}
    {%- assign og_image_url = article.image | image_url: width: 1200 -%}
  {%- endif -%}
{%- elsif request.page_type == 'collection' -%}
  {%- if collection.image -%}
    {%- assign og_image_url = collection.image | image_url: width: 1200 -%}
  {%- endif -%}
{%- endif -%}

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image_url -%}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image_url -%}
  <meta name="twitter:image" content="{{ og_image_url }}">
{%- endif -%}

<!-- JSON-LD Structured Data: Organization -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ shop.name }}",
  "url": "{{ shop.url }}",
  "logo": "{{ 'logo.png' | asset_url }}",
  "sameAs": [
    "{{ settings.social_instagram_link }}",
    "{{ settings.social_facebook_link }}",
    "{{ settings.social_tiktok_link }}"
  ]
}
</script>

<!-- JSON-LD Structured Data: Product (when on PDP) -->
{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": "{{ product.title | escape }}",
    "url": "{{ shop.url }}{{ product.url }}",
    {%- if product.featured_image -%}
      "image": [
        "{{ product.featured_image | image_url: width: 1000 }}"
      ],
    {%- endif -%}
    "description": "{{ product.description | strip_html | escape }}",
    "brand": {
      "@type": "Brand",
      "name": "Maykey"
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": "{{ variant.sku }}",
          "priceCurrency": "PKR",
          "price": "{{ variant.price | divided_by: 100.00 }}",
          "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "url": "{{ shop.url }}{{ variant.url }}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}
