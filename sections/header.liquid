{% comment %}
  Maykey Hair Care — Sticky Header & Mobile Navigation Drawer
{% endcomment %}
<header class="site-header-wrapper" id="siteHeader">
  <div class="container site-header">
    <!-- Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" class="header-logo-link" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            class="header-logo-img"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <span class="header-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu -->
    <nav class="header-nav" role="navigation" aria-label="Primary Navigation">
      <ul class="header-nav-list">
        {%- for link in section.settings.menu.links -%}
          {%- assign link_title_downcase = link.title | downcase -%}
          {%- if link_title_downcase contains 'shade' -%}
            <li class="shade-dropdown">
              <button
                type="button"
                class="shade-dropdown-trigger"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{{ link.title }}</span>
                {% render 'icon-chevron', size: 12 %}
              </button>
              <div class="shade-dropdown-menu" role="menu">
                <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=natural-black" class="shade-dropdown-item" role="menuitem">
                  <div class="shade-swatch-circle" style="background-color: var(--shade-natural-black);"></div>
                  <span>Natural Black</span>
                </a>
                <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=dark-brown" class="shade-dropdown-item" role="menuitem">
                  <div class="shade-swatch-circle" style="background-color: var(--shade-dark-brown);"></div>
                  <span>Dark Brown</span>
                </a>
                <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=light-brown" class="shade-dropdown-item" role="menuitem">
                  <div class="shade-swatch-circle" style="background-color: var(--shade-light-brown);"></div>
                  <span>Light Brown</span>
                </a>
              </div>
            </li>
          {%- else -%}
            <li>
              <a href="{{ link.url }}" class="header-nav-link {% if link.active %}active{% endif %}">
                {{ link.title }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="header-icon-btn" aria-label="Search">
        {% render 'icon-search', size: 20 %}
      </a>

      <button
        type="button"
        class="header-icon-btn"
        data-cart-drawer-trigger
        aria-label="Cart ({{ cart.item_count }} items)"
      >
        {% render 'icon-cart', size: 20 %}
        <span class="header-cart-badge">{{ cart.item_count }}</span>
      </button>

      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobileMenuToggle"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-overlay" id="mobileNavOverlay" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="mobile-nav-header">
      <span class="mobile-nav-title">{{ shop.name }}</span>
      <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Close navigation menu">
        {% render 'icon-close', size: 20 %}
      </button>
    </div>

    <div class="mobile-nav-body">
      <!-- Search Bar Shortcut -->
      <form action="{{ routes.search_url }}" method="get" class="mobile-nav-search">
        <input type="text" name="q" placeholder="Search hair darkening products..." aria-label="Search store">
        <button type="submit" aria-label="Submit search">
          {% render 'icon-search', size: 18 %}
        </button>
      </form>

      <!-- Nav Links -->
      <ul class="mobile-nav-list">
        <li>
          <a href="{{ routes.root_url }}" class="mobile-nav-link">Home</a>
        </li>
        <li>
          <a href="{{ routes.all_products_collection_url }}" class="mobile-nav-link">Shop All Products</a>
        </li>

        <!-- Shades Accordion -->
        <li class="mobile-nav-accordion">
          <button type="button" class="mobile-nav-accordion-trigger" aria-expanded="false">
            <span>Explore Shades</span>
            {% render 'icon-chevron', size: 14 %}
          </button>
          <div class="mobile-nav-submenu">
            <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=natural-black" class="mobile-submenu-item">
              <span class="shade-swatch-circle" style="background-color: var(--shade-natural-black);"></span>
              <div>
                <strong>Natural Black</strong>
                <span>100% Gray Coverage</span>
              </div>
            </a>
            <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=dark-brown" class="mobile-submenu-item">
              <span class="shade-swatch-circle" style="background-color: var(--shade-dark-brown);"></span>
              <div>
                <strong>Dark Brown</strong>
                <span>Rich Golden Tones</span>
              </div>
            </a>
            <a href="/products/maykey-hair-darkening-shampoo-250ml?variant=light-brown" class="mobile-submenu-item">
              <span class="shade-swatch-circle" style="background-color: var(--shade-light-brown);"></span>
              <div>
                <strong>Light Brown</strong>
                <span>Natural Caramel Glow</span>
              </div>
            </a>
          </div>
        </li>

        {%- for link in section.settings.menu.links -%}
          {%- assign l_title = link.title | downcase -%}
          {%- unless l_title contains 'home' or l_title contains 'shade' or l_title contains 'all' -%}
            <li>
              <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
            </li>
          {%- endunless -%}
        {%- endfor -%}

        <li>
          <a href="/pages/contact" class="mobile-nav-link">Contact & Support</a>
        </li>
      </ul>

      <!-- Direct WhatsApp Action in Drawer -->
      {%- assign whatsapp_number = settings.whatsapp_number | default: '923000000000' -%}
      <div class="mobile-nav-whatsapp-card">
        <div class="mobile-nav-wa-header">
          <span class="wa-dot"></span>
          <strong>WhatsApp Support Available</strong>
        </div>
        <p>Questions about shades, orders or delivery? Chat with our team directly.</p>
        <a
          href="https://wa.me/{{ whatsapp_number }}?text=Hi%20Maykey%20Hair%20Care!%20I%20have%20a%20question."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-mobile-wa"
        >
          {% render 'icon-chat', size: 16 %}
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>

    <div class="mobile-nav-footer">
      <div class="mobile-nav-trust">
        <span>{% render 'icon-package', size: 14 %} Cash on Delivery Nationwide</span>
        <span>{% render 'icon-truck', size: 14 %} Free Delivery on Rs. 2,500+</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
