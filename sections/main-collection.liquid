{% comment %}
  Maykey Hair Care — Collection Grid Section
{% endcomment %}
<section class="section collection-section" id="collectionSection">
  <div class="container">
    <div class="collection-header-box">
      <div class="section-eyebrow center">{{ 'Our Products' }}</div>
      <h1 class="section-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="section-subtitle center" style="margin: 12px auto 0;">
          {{ collection.description }}
        </div>
      {%- else -%}
        <p class="section-subtitle center" style="margin: 12px auto 0;">
          Explore fast 15-minute hair darkening shampoos infused with Argan Oil, Biotin, Keratin, and Olive Extract.
        </p>
      {%- endif -%}
    </div>

    <!-- Quick Trust Badges Strip on Collection -->
    <div class="collection-trust-strip">
      <span class="trust-pill-mini">{% render 'icon-package', size: 12 %} Cash on Delivery</span>
      <span class="trust-pill-mini">{% render 'icon-truck', size: 12 %} Free Delivery on Rs. 2,500+</span>
      <span class="trust-pill-mini">{% render 'icon-shield', size: 12 %} 0% Ammonia Safe Formula</span>
      <span class="trust-pill-mini">{% render 'icon-clock', size: 12 %} 15-Minute Results</span>
    </div>

    {%- paginate collection.products by 12 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, show_quick_add: true %}
        {%- else -%}
          <div class="collection-empty-box">
            <p>No products found in this collection.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: 16px;">
              <span>View All Products</span>
            </a>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination-wrap">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
