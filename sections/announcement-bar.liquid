{% comment %}
  Maykey Hair Care — Announcement Bar Section
  Supports dynamic announcement blocks with icons and links
{% endcomment %}
{%- if section.settings.show_announcement -%}
  <div
    class="announcement-bar-section"
    style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
  >
    <div class="announcement-inner">
      {%- for block in section.blocks -%}
        <div class="announcement-item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              {% render 'icon-truck', size: 14 %}
            {%- when 'package' -%}
              {% render 'icon-package', size: 14 %}
            {%- when 'clock' -%}
              {% render 'icon-clock', size: 14 %}
            {%- when 'shield' -%}
              {% render 'icon-shield', size: 14 %}
          {%- endcase -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">
              {{ block.settings.text }}
            </a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>

        {%- unless forloop.last -%}
          <span class="announcement-sep" aria-hidden="true"></span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F9F8F6"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery Truck" },
            { "value": "package", "label": "COD Package" },
            { "value": "clock", "label": "15-Min Timer" },
            { "value": "shield", "label": "Shield / 0% Ammonia" }
          ],
          "default": "truck"
        },
        {
          "type": "html",
          "id": "text",
          "label": "Text (HTML supported)",
          "default": "Free Delivery on Orders Above <span class=\"gold\">Rs. 2,500</span>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "truck",
            "text": "Free Delivery on Orders Above <span class=\"gold\">Rs. 2,500</span>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "package",
            "text": "Cash on Delivery Available Nationwide"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "clock",
            "text": "Fast 15-Minute Color Treatment"
          }
        }
      ]
    }
  ]
}
{% endschema %}
